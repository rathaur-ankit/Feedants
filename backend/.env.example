# ==============================================================================
# FEEDANTS BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and replace dummy values with your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & CLUSTERING CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Express server to listen on
PORT=5000

# Environment mode: development | production | test
NODE_ENV=development

# Allowed CORS origin (* for all origins, or e.g., http://localhost:8081 for frontend)
CORS_ORIGIN=*

# Clustering concurrency (0 = auto-fork all available CPU cores, 1 = single process)
MAX_WORKERS=0

# High-concurrency in-memory cache TTL in seconds (for read-heavy routes)
CACHE_TTL_SECONDS=30

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection connection string (Local or MongoDB Atlas Cluster)
# Example Local: mongodb://localhost:27017
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net
MONGO_URI=mongodb+srv://dummy_username:dummy_password@cluster0.mongodb.net

# Database name within the MongoDB cluster
DB_NAME=feedants

# ------------------------------------------------------------------------------
# AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens
JWT_SECRET=your_jwt_secret_key_32_chars_or_more_dummy

# Token expiration time (e.g., 1h, 24h, 7d, 30d)
JWT_EXPIRY=7d

# ------------------------------------------------------------------------------
# MEDIA STORAGE (Cloudinary)
# Required for uploading submission videos, photos, and performer avatars
# ------------------------------------------------------------------------------
# Cloudinary Cloud Name (from Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_dummy

# Cloudinary API Key
CLOUDINARY_API_KEY=123456789012345

# Cloudinary API Secret
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_dummy

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay Key ID (Test key starts with rzp_test_, Live key starts with rzp_live_)
RAZORPAY_KEY_ID=rzp_test_your_dummy_key_id

# Razorpay Key Secret
RAZORPAY_KEY_SECRET=your_dummy_razorpay_secret

# ------------------------------------------------------------------------------
# DISTRIBUTED CACHE (Redis - Optional)
# ------------------------------------------------------------------------------
# Redis connection URL for multi-server caching or rate limiting
REDIS_URL=redis://localhost:6379
