# ==============================================================================
# FEEDANTS FRONTEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and adjust the API endpoint as needed.
# Note: In Expo SDK 49+, environment variables prefixed with EXPO_PUBLIC_
# are automatically accessible in client code via process.env.EXPO_PUBLIC_*
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND API BASE URL
# ------------------------------------------------------------------------------
# Web Browser / iOS Simulator: http://localhost:5000/api/v1
# Android Emulator:           http://10.0.2.2:5000/api/v1
# Physical Device (LAN IP):   http://192.168.1.X:5000/api/v1
# Production Deployed API:    https://api.yourdomain.com/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# Public Razorpay Key ID used for checkout initiation
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_dummy_key_12345
